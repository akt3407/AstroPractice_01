---
import "@fontsource/lato";
import "@fontsource-variable/noto-sans-jp/wght.css";
import "../styles/global.css";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import Loading from "@/components/ui/Loading.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "KAGU",
  description = "仮想家具ブランドKAGUのLPです。",
  ogImage = "/og.png",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Loading />
    <Header />
    <main id="content" class="invisible">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import Lenis from "lenis";
  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!prefersReducedMotion) {
    const lenis = new Lenis({
      autoRaf: false,
      duration: 1.5,
      lerp: 0.12,
      smoothWheel: true,
      syncTouch: false,
      wheelMultiplier: 0.8,
    });

    (window as Window & { lenis?: Lenis }).lenis = lenis;

    lenis.on("scroll", ScrollTrigger.update);

    gsap.ticker.add((time) => {
      lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);
  }

  if (!prefersReducedMotion) {
    document
      .querySelectorAll<HTMLElement>("[data-fade-group]")
      .forEach((group) => {
        ScrollTrigger.create({
          trigger: group,
          start: "top 80%",
          once: true,
          onEnter: () =>
            gsap.to(group.children, {
              opacity: 1,
              y: 0,
              duration: 1.2,
              ease: "power1.out",
              stagger: 0.15,
              delay: Number(group.dataset.fadeDelay) || 0,
            }),
        });
      });

    ScrollTrigger.batch("[data-fade-in]:not([data-fade-group])", {
      start: "top 85%",
      once: true,
      // data-fade-delay があれば要素ごとに開始を遅らせる（見出しの後に出す等）。
      // stagger は手動で index*0.1 を足して再現。
      onEnter: (els) =>
        els.forEach((el, i) =>
          gsap.to(el, {
            opacity: 1,
            y: 0,
            duration: 1.2,
            ease: "power1.out",
            delay: (Number((el as HTMLElement).dataset.fadeDelay) || 0) + i * 0.1,
          }),
        ),
    });
  }
</script>
