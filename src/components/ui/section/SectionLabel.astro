---
interface Props {
  label: string;
  class?: string;
}

const { label, class: _class } = Astro.props;
---

<small
  class={`font-en text-16a inline-block overflow-hidden leading-none font-bold md:ml-4 ${_class}`}
  data-section-label
>
  <span
    class="inline-block transform-[translateY(100%)] will-change-transform motion-reduce:transform-[translateY(0)]"
    data-section-label-text>{label}</span
  >
</small>
