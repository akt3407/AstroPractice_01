---
interface Props {
  class?: string;
  heading: string;
}

const { class: className = "", heading } = Astro.props;

// heading は <br>/<span> を含む HTML 文字列。タグを除いた素テキストを aria-label に
// 明示し、SR には行マスク分割や境界スペースの影響なく1文として読ませる。
const ariaLabel = heading
  .replace(/<[^>]*>/g, "")
  .replace(/\s+/g, " ")
  .trim();
---

<h2
  class:list={[
    "text-32/normal mt-16 overflow-hidden font-medium tracking-[0.04em] md:mt-20",
    className,
  ]}
  data-section-label
  aria-label={ariaLabel}
  set:html={heading}
/>

<script>
  // 見出しを <br> 区切りで行マスク化し、行ごとにスライドアップで reveal する。
  // 文字分割や座標計測は行わず、レスポンシブ改行は CSS（md:hidden な <br>）に委ねる。

  // <br> 境界で childNodes を行マスク（.line > .line-inner）に包む。
  // <br> は元のまま（md:hidden クラス付き）マスク間に再挿入してレスポンシブ改行を保つ。
  // SectionLabel は静的に同じマスク構造（[data-section-label-text]）を持つので再構築しない。
  function buildLineInners(el: HTMLElement): HTMLElement[] {
    const preBuilt = el.querySelector<HTMLElement>("[data-section-label-text]");
    if (preBuilt) return [preBuilt];

    if (el.dataset.split === "true") {
      return Array.from(el.querySelectorAll<HTMLElement>(".line-inner"));
    }

    const groups: Node[][] = [[]];
    const brs: HTMLElement[] = [];
    Array.from(el.childNodes).forEach((node) => {
      if (
        node.nodeType === Node.ELEMENT_NODE &&
        (node as Element).tagName === "BR"
      ) {
        brs.push(node as HTMLElement);
        groups.push([]);
      } else {
        groups[groups.length - 1].push(node);
      }
    });

    el.textContent = "";
    const inners: HTMLElement[] = [];
    groups.forEach((group, i) => {
      if (i > 0) el.appendChild(brs[i - 1]); // 元の <br> を再挿入（隙間防止のため前後に空白を入れない）
      const hasContent = group.some(
        (n) =>
          n.nodeType === Node.ELEMENT_NODE ||
          (n.textContent ?? "").trim() !== "",
      );
      if (!hasContent) {
        group.forEach((n) => el.appendChild(n)); // 空白のみのグループはそのまま戻す
        return;
      }
      const mask = document.createElement("span");
      mask.className = "line";
      mask.style.display = "inline-block";
      mask.style.overflow = "hidden";
      mask.style.verticalAlign = "top";
      const inner = document.createElement("span");
      inner.className = "line-inner";
      inner.style.display = "inline-block";
      inner.style.willChange = "transform";
      inner.style.transform = "translateY(100%)";
      group.forEach((n) => inner.appendChild(n));
      mask.appendChild(inner);
      el.appendChild(mask);
      inners.push(inner);
    });
    el.dataset.split = "true";
    return inners;
  }

  function reveal(inners: HTMLElement[], animated: boolean) {
    // 直前の兄弟が「実際に表示されている <br>」のときだけ視覚行を1段進める。
    // <br class="md:hidden"> が CSS で消える PC では同一行扱いになり、
    // 同じディレイで一括スライドアップするので br の位置で途切れない。
    let row = 0;
    inners.forEach((inner, i) => {
      if (i > 0) {
        const prev = inner.parentElement?.previousElementSibling;
        const brVisible =
          prev instanceof HTMLElement &&
          prev.tagName === "BR" &&
          getComputedStyle(prev).display !== "none";
        if (brVisible) row++;
      }
      inner.style.transition = animated
        ? `transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) ${row * 0.12}s`
        : "none";
      inner.style.transform = "translateY(0%)";
    });
  }

  function initSectionLabels() {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    document
      .querySelectorAll<HTMLElement>("[data-section-label]")
      .forEach((el) => {
        const inners = buildLineInners(el);
        if (!inners.length) return;

        if (reduceMotion) {
          reveal(inners, false); // アニメ無しで即時表示
          return;
        }

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              reveal(inners, true);
              obs.unobserve(el);
            });
          },
          // 画面下端から 25% 上に入ってから発火させ、ビューポート内で
          // アニメが再生されるようにする（早すぎて見逃すのを防ぐ）
          { threshold: 0, rootMargin: "0px 0px -25% 0px" },
        );
        observer.observe(el);
      });
  }

  document.addEventListener("astro:page-load", initSectionLabels);
  initSectionLabels();
</script>
