---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class:list={[
    "relative inline-block after:absolute after:bottom-[-0.3rem] after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-500 after:ease-out after:content-[''] hover:after:scale-x-100 group-hover/link:after:scale-x-100",
    className,
  ]}
>
  <slot />
</span>
