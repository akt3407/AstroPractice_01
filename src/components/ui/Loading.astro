---
import { Image } from "astro:assets";

import logo from "@/assets/logo.svg";
---

<div
  id="loading"
  class="fixed inset-0 z-50 flex flex-col items-center justify-center gap-4 bg-white transition-opacity duration-1200 ease-out"
>
  <Image class="aspect-117/33 w-117" src={logo} alt="" />
  <p
    id="loading-percent"
    class="font-en mt-17 text-[1.6rem] font-bold md:mt-22"
  >
    0%
  </p>
</div>

<script>
  const loading = document.getElementById("loading");
  const content = document.getElementById("content");
  const percent = document.getElementById("loading-percent");

  // 0% → 100% を最低この時間かけて進める（ms）
  const MIN_DURATION = 1200;
  const TICK = 60;

  let current = 0;
  let loaded = false;
  const start = performance.now();

  const timer = setInterval(() => {
    const elapsed = performance.now() - start;
    const target = Math.min(100, (elapsed / MIN_DURATION) * 100);
    if (target > current) {
      current = Math.floor(target);
      if (percent) percent.textContent = `${current}%`;
    }
    if (loaded && current >= 100) finish();
  }, TICK);

  function finish() {
    clearInterval(timer);
    if (percent) percent.textContent = "100%";
    setTimeout(() => {
      loading?.classList.add("opacity-0");
      content?.classList.remove("invisible");
      setTimeout(() => {
        loading?.classList.add("hidden");
      }, 1000);
    }, 500);
  }

  window.addEventListener("load", () => {
    loaded = true;
    if (current >= 100) finish();
  });
</script>
