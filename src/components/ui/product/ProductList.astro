---
import ResponsivePicture from "../common/ResponsivePicture.astro";

import imgProductSp from "@/assets/img-product-sp.jpg";
import imgProductPc from "@/assets/img-product.jpg";
---

<div>
  <a href="/" class="group block">
    <ResponsivePicture
      class="block overflow-hidden"
      mobileImg={imgProductSp}
      desktopImg={imgProductPc}
      alt=""
      mobileWidth={158}
      mobileHeight={219}
      desktopWidth={330}
      desktopHeight={465}
      imgClass="md:aspect-330/465 md:size-full md:object-cover md:transition-transform md:duration-600 md:ease-out md:group-hover:scale-130"
    />
    <div
      class="text-12 font-en mt-7 flex items-center justify-between tracking-[0.01em] transition-opacity duration-600 group-hover:opacity-50"
    >
      <p>001</p>
      <p>PRODUCT</p>
    </div>
  </a>
</div>
