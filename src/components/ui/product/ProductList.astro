---
import { Image } from "astro:assets";

import imgProduct from "@/assets/img-product.jpg";
---

<div>
  <a href="/" class="group block">
    <div
      class="aspect-158/219 w-158 overflow-hidden md:aspect-330/465 md:w-330"
    >
      <Image
        class="size-full object-cover transition-transform duration-600 ease-out group-hover:scale-130"
        src={imgProduct}
        alt="木の椅子"
      />
    </div>
    <div
      class="text-12 mt-7 flex items-center justify-between font-mono tracking-[0.01em] transition-opacity duration-600 group-hover:opacity-50"
    >
      <p>001</p>
      <p>PRODUCT</p>
    </div>
  </a>
</div>
