    <div class="aspect-158/219 w-full overflow-hidden md:aspect-330/465">
      <Image
        class="size-full object-cover transition-transform duration-600 ease-out group-hover:scale-130"
        src={imgProduct}
        alt=""
      />
    </div>
    <div
      class="text-12 font-en mt-7 flex items-center justify-between tracking-[0.01em] transition-opacity duration-600 group-hover:opacity-50"
    >
      <p>001</p>
      <p>PRODUCT</p>
    </div>
  </a>
</div>
