---
import { Image } from "astro:assets";

import footerImg from "@/assets/img-footer.jpg";
import Logo from "@/assets/logo-footer.svg";
import HoverUnderline from "@/components/ui/common/HoverUnderline.astro";
import { PAGES } from "@/constants/site";
import { SNSS } from "@/constants/site";
---

<footer class="bg-black text-white">
  <div
    class="grid grid-cols-4 gap-20 px-20 pt-46 pb-24 md:grid-cols-12 md:px-30 md:pt-80 md:pb-20"
  >
    <Image
      class="col-span-3 col-start-1 row-start-1 md:col-span-6"
      src={Logo}
      alt="KAGU"
    />
    <dl class="col-span-full row-start-2 mt-50 md:col-span-6 md:col-start-1">
      <div
        class="border-border-dark col-span-full border-b pb-20 md:grid md:grid-cols-6 md:py-32 md:pb-33"
      >
        <dt class="text-16a/tight font-en col-span-1 font-semibold">Address</dt>
        <dd class="text-16b/[1.16] mt-12 md:col-span-4 md:col-start-3 md:mt-3">
          〒000-1234 愛知県名古屋市1234
        </dd>
      </div>
      <div
        class="border-border-dark border-b py-20 md:grid md:grid-cols-6 md:py-32"
      >
        <dt class="text-16a/tight font-en font-semibold">Navigation</dt>
        <dd class="mt-12 md:col-span-4 md:col-start-3 md:mt-0">
          <ul class="text-16b/[1.16] font-en flex">
            {
              PAGES.map((page, index) => (
                <li
                  class={`after:mx-8 after:text-gray-400 after:content-['/'] ${
                    index === PAGES.length - 1 ? "after:content-none" : ""
                  }`}
                >
                  <a
                    href={page.href}
                    data-scroll={page.scroll}
                    class="uppercase"
                  >
                    <HoverUnderline>{page.label}</HoverUnderline>
                  </a>
                </li>
              ))
            }
          </ul>
        </dd>
      </div>
      <div
        class="border-border-dark border-b py-20 md:grid md:grid-cols-6 md:py-32"
      >
        <dt class="text-16a/tight font-en font-semibold">SNS</dt>
        <dd class="text-16b/[1.16] mt-12 md:col-span-4 md:col-start-3 md:mt-0">
          {
            SNSS.map((sns, index) => (
              <a
                class={`after:mx-8 after:text-gray-400 after:content-['/'] ${index === SNSS.length - 1 ? "after:content-none" : ""}`}
                href={sns.href}
              >
                <HoverUnderline>{sns.label}</HoverUnderline>
              </a>
            ))
          }
        </dd>
      </div>
    </dl>
    <small
      class="font-en col-span-2 col-start-1 row-start-3 self-end text-[1.2rem]/[1.4] md:col-span-2"
      >©KAGU 2025</small
    >
    <Image
      class="col-span-2 col-start-3 row-start-3 mt-5 aspect-157/142 w-157 md:col-span-5 md:col-start-8 md:row-start-1 md:row-end-4 md:mt-0 md:aspect-563/646 md:h-646 md:w-563"
      src={footerImg}
      alt=""
    />
  </div>
</footer>
