---
import { Image } from "astro:assets";

import logo from "@/assets/logo.svg";
import HoverUnderline from "@/components/ui/common/HoverUnderline.astro";
import { PAGES } from "@/constants/site";
import ArrowIcon from "@/svgs/arrow.svg?raw";
---

<header
  id="site-header"
  class="group border-border fixed inset-x-10 top-16 z-10 flex flex-wrap items-center justify-between border bg-white py-15 pr-24 pl-20 md:py-7 md:pr-6 md:pl-16"
>
  <a href="/">
    <Image
      src={logo}
      alt="KAGU"
      width={52.8}
      height={14.82}
      class="h-auto"
      style="width: clamp(33px, 5vw, 52.8px)"
    />
  </a>
  <button
    id="menu-button"
    class="flex flex-col gap-y-4 md:hidden"
    type="button"
    aria-label="メニューを開く"
    aria-expanded="false"
    aria-controls="nav-menu"
  >
    <span
      aria-hidden="true"
      class="block h-px w-[17px] origin-center bg-black transition-transform duration-1000 ease-out group-data-[menu-open=true]:translate-y-[2.5px] group-data-[menu-open=true]:rotate-45"
    ></span>
    <span
      aria-hidden="true"
      class="block h-px w-[17px] origin-center bg-black transition-transform duration-1000 ease-out group-data-[menu-open=true]:-translate-y-[2.5px] group-data-[menu-open=true]:-rotate-45"
    ></span>
  </button>
  <nav
    aria-label="グローバルナビゲーション"
    id="nav-menu"
    class="max-h-0 w-full overflow-hidden transition-[max-height] duration-800 ease-out group-data-[menu-open=true]:max-h-[327px] md:mt-0 md:flex md:max-h-none md:w-auto md:overflow-visible md:transition-none"
  >
    <ul class="text-14 font-en flex flex-col md:flex-row md:gap-x-20">
      {
        PAGES.map((page) => (
          <li class="before:bg-border relative pt-42 pb-16 not-first:pt-16 before:absolute before:inset-x-0 before:top-0 before:h-px before:origin-left before:scale-x-0 before:transition-transform before:duration-1200 before:ease-out before:content-[''] group-data-[menu-open=true]:before:scale-x-100 first:before:hidden md:py-16 md:before:hidden">
            <a
              href={page.href}
              class="inline-block overflow-hidden md:overflow-visible"
            >
              <span class="inline-block translate-y-full transition-transform duration-1000 ease-out group-data-[menu-open=true]:translate-y-0 md:translate-y-0 md:transition-none">
                <HoverUnderline>{page.label}</HoverUnderline>
              </span>
            </a>
          </li>
        ))
      }
      <li
        class="before:bg-border relative py-16 before:absolute before:inset-x-0 before:top-0 before:h-px before:origin-left before:scale-x-0 before:transition-transform before:duration-1200 before:ease-out before:content-[''] group-data-[menu-open=true]:before:scale-x-100 md:hidden"
      >
        <!-- SP用CONTACT -->
        <a
          href="#"
          class="block overflow-hidden"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span
            class="flex translate-y-full items-center gap-10 transition-transform duration-1200 ease-out group-data-[menu-open=true]:translate-y-0"
          >
            CONTACT
            <Fragment set:html={ArrowIcon} />
            <span class="sr-only">（新しいタブで開く）</span>
          </span>
        </a>
      </li>
    </ul>
  </nav>
  <!-- PC用CONTACT -->
  <a
    href="#"
    class="md:border-border hidden md:flex md:items-center md:gap-16 md:border md:py-14 md:pr-10 md:pl-16 md:text-[1.2rem]/[1.4] md:font-medium md:transition-colors md:duration-480 md:hover:bg-black md:hover:text-white"
    target="_blank"
    rel="noopener noreferrer"
  >
    CONTACT
    <Fragment set:html={ArrowIcon} />
    <span class="sr-only">（新しいタブで開く）</span>
  </a>
</header>

<div
  id="overlay"
  class="pointer-events-none fixed inset-0 z-9 bg-white/40 opacity-0 backdrop-blur-md transition-opacity duration-1000 ease-out"
>
</div>

<script>
  const button = document.getElementById("menu-button")!;
  const header = document.getElementById("site-header")!;
  const overlay = document.getElementById("overlay")!;

  button.addEventListener("click", () => {
    const isOpen = button.getAttribute("aria-expanded") === "true";
    const nextOpen = !isOpen;

    button.setAttribute("aria-expanded", String(nextOpen));
    button.setAttribute(
      "aria-label",
      nextOpen ? "メニューを閉じる" : "メニューを開く",
    );
    header.dataset.menuOpen = String(nextOpen);
  });

  button?.addEventListener("click", () => {
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("pointer-events-none");
  });

  overlay?.addEventListener("click", () => {
    overlay?.classList.add("opacity-0", "pointer-events-none");
    button.setAttribute("aria-expanded", "false");
    button.setAttribute("aria-label", "メニューを開く");
    header.dataset.menuOpen = "false";
  });
</script>
