---
import FadeIn from "../ui/common/FadeIn.astro";
import GridBox from "../ui/common/GridBox.astro";
import ResponsivePicture from "../ui/common/ResponsivePicture.astro";

import SectionHeading from "@/components/ui/section/SectionHeading.astro";
import SectionLabel from "@/components/ui/section/SectionLabel.astro";
import { aboutImages } from "@/data/aboutImages";
---

<GridBox id="about" class="content-start">
  <div
    class="col-span-4 col-start-1 pt-86 md:col-span-7 md:col-start-2 md:row-start-1 md:pt-150"
  >
    <SectionLabel label="(ABOUT)" />
    <SectionHeading
      heading="目的を持ってつくられ、<br class='md:hidden'>時を超えて愛される家具。"
    />
    <FadeIn delay={0.5}>
      <p class="text-16a/[1.8] mt-14 tracking-[0.04em] md:mt-30 md:ml-4">
        KOZOUでは、家具は単なる道具ではなく、そこに込められた手仕事・想い・文化の結晶だと考えています。<br
          class="hidden md:block"
        />私たちが届ける家具はすべて、熟練の職人が素材選びから仕上げまで一貫して丁寧に手がけた一点ものです。「使い手の心に響き、時間とともに美しく育ち、語るべき物語を持つ家具」それが私たちの目指すものづくりです。すべての家具が唯一無二である理由。<br
          class="md:hidden"
        />それは、すべての手と人生が唯一無二だから。<br
        />伝統への敬意と、普遍的な美意識を持って、世代を超えて受け継がれる家具を、今日もひとつずつ、丁寧に。
      </p>
    </FadeIn>
  </div>
  <div
    class="col-span-4 col-start-1 md:col-span-12 md:col-start-1 md:row-start-2"
  >
    <FadeIn
      group
      class="mt-60 grid grid-cols-4 gap-x-20 md:mt-99 md:grid-cols-12"
    >
      <ResponsivePicture
        class="col-span-3 col-start-1 md:col-span-4 md:col-start-1"
        imgClass=""
        mobileImg={aboutImages.img01.mobileImg}
        desktopImg={aboutImages.img01.desktopImg}
        alt="ペーパーコードの座面とダークブラウンの木製フレームが特徴的なYチェアのクローズアップ"
        mobileWidth={246}
        mobileHeight={183}
        desktopWidth={447}
        desktopHeight={332}
      />
      <ResponsivePicture
        class="col-span-3 col-start-2 mt-38 md:col-span-8 md:col-start-5 md:mt-0"
        imgClass="aspect-246/327 md:aspect-913/685"
        mobileImg={aboutImages.img02.mobileImg}
        desktopImg={aboutImages.img02.desktopImg}
        alt="落ち着いた緑色の天板と深い色味の木製フレームを組み合わせたデスク。上には開かれた本とキャンドル"
        mobileWidth={246}
        mobileHeight={327}
        desktopWidth={913}
        desktopHeight={685}
      />
    </FadeIn>
    <div class="marquee-wrap relative mt-98 overflow-hidden md:mt-130">
      <p
        class="animation-scroll-rtl text-170 font-en inline-block font-bold tracking-[0.01em] whitespace-nowrap"
      >
        FOUNDED IN 1998,FOUNDED IN 1998,
      </p>
    </div>
    <div
      class="col-span-full mt-87 mb-80 grid grid-cols-subgrid md:mt-136 md:mb-122"
    >
      <div
        class="col-span-4 col-start-1 md:col-span-4 md:col-start-7 md:row-start-3 md:pt-196"
      >
        <SectionHeading heading="熟練の職人による緻密な設計" />
        <FadeIn delay={0.5}>
          <p class="text-16a/[1.8] mt-14 tracking-[0.04em] md:mt-30">
            手道具だけを使い、時間をかけて、丁寧に。<br />
            その椅子は今も、友人の家にあります。<br />
            すっかり馴染みながらも、決して壊れていない。<br />
            それは、私たちの原点であり、<br />
            ものづくりの本質を思い出させてくれる存在です。
          </p>
        </FadeIn>
      </div>
      <FadeIn
        class="col-span-4 col-start-1 mt-37 md:col-span-5 md:col-start-1 md:row-start-3 md:mt-0 md:-ml-30"
      >
        <ResponsivePicture
          mobileImg={aboutImages.img03.mobileImg}
          desktopImg={aboutImages.img03.desktopImg}
          alt="自然な木の形状を活かした丸テーブルと、枝を生けた花瓶が置かれた明るい和モダンのリビング空間"
          mobileWidth={335}
          mobileHeight={273}
          desktopWidth={593}
          desktopHeight={644}
        />
      </FadeIn>
    </div>
  </div>
</GridBox>
