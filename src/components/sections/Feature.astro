---
import { Image } from "astro:assets";

import FadeIn from "../ui/common/FadeIn.astro";
import GridBox from "../ui/common/GridBox.astro";

import type { ImageMetadata } from "astro";

import bgFeature from "@/assets/bg-feature.jpg";
import SectionHeading from "@/components/ui/section/SectionHeading.astro";
import SectionLabel from "@/components/ui/section/SectionLabel.astro";

const featureImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/img-feature-*.jpg",
  { eager: true },
);

const featureImageList = Object.keys(featureImages)
  .sort()
  .map((key) => featureImages[key].default);

interface CardItem {
  number: string;
  title: string;
  description: string;
  alt: string;
}

const cards: CardItem[] = [
  {
    number: "01",
    title: "職人による一点もの",
    description:
      'すべての家具は、熟練の職人が一点ずつ手仕事で仕上<br class="md:hidden"/>げています。<br />木目の個性、細部の仕口、触れたときの感触にまで気<br class="md:hidden"/>を配った仕上がりは、大量生産にはない温もりと品格<br class="md:hidden"/>を宿します。',
    alt: "木製椅子のフレームを丁寧に調整する職人の手元。背景には温かい光のテーブルランプとサイドボード",
  },
  {
    number: "02",
    title: "素材を活かすデザイン",
    description:
      '無垢材や天然塗料など、自然素材の魅力を活かすシン<br class="md:hidden"/>プルなデザインが特徴。木の表情を隠さず、素材<br class="md:hidden" />の“声”をそのまま活かすことで、空間にすっとなじむ静<br class="md:hidden"/>かな存在感を放ちます。',
    alt: "天然木の節を活かしたサイドテーブル。天板の上には黒いマグカップと本、リンゴが置かれている",
  },
  {
    number: "03",
    title: "経年変化が楽しめる",
    description:
      '無垢材や自然素材は、生きているように表情を変えて<br class="md:hidden"/>いきます。<br class="hidden md:block"/>磨かれ、傷つき、艶を帯びながら、<br class="hidden md:block">その変化さ<br class="md:hidden"/>えも「味」となるように設計されています。',
    alt: "有機的な曲線を持つ一枚板のローテーブルと、リネン素材のローソファが置かれたモダンなリビング",
  },
];
---

<GridBox
  class="relative bg-cover bg-center text-white before:absolute before:inset-0 before:bg-[#000000]/60 before:content-['']"
  style={`background-image: url(${bgFeature.src})`}
>
  <div
    class="relative z-5 col-span-full grid grid-cols-subgrid pt-56 pb-89 md:pt-100 md:pb-159"
  >
    <div class="col-span-full">
      <SectionLabel label="(FEATURE)" />
      <SectionHeading>
        <span class="text-34 font-en md:ml-2">KAGU</span>の特徴
      </SectionHeading>
      <FadeIn>
        <p class="text-16a/[1.8] mt-14 md:mt-27 md:ml-4">
          本物のクラフトマンシップは、静かな細部に宿ると私た<br
            class="md:hidden"
          />ちは考えます。<br
            class="hidden md:block"
          />脚のわずかな曲線、見えない部分の仕<br
            class="md:hidden"
          />口、手ざわりまで磨き上げたエッジ。<br />
          それらは偶然ではなく、心と時間を込めた「選択」です。<br /> すべてのディテールに意味があるとき、家具は忘れら<br
            class="md:hidden"
          />れない存在になるのです。
        </p>
      </FadeIn>
    </div>
    <div class="col-span-full mt-76 grid grid-cols-subgrid md:mt-100">
      {
        cards.map((card, i) => (
          <div class="col-span-full border-t border-white pt-20 not-first:mt-34 md:grid md:grid-cols-subgrid md:pt-50 md:not-first:mt-75">
            <p class="text-16a font-en font-bold tracking-[-0.01em] md:col-span-1 md:row-start-1">
              {card.number}
            </p>
            <h3 class="text-24b/[1.4] mt-10 font-medium tracking-[0.04em] md:col-span-3 md:col-start-3 md:row-start-1 md:mt-0">
              {card.title}
            </h3>
            <FadeIn class="md:col-span-5 md:col-start-8" group>
              <p
                class="text-16a/[1.8] mt-10 tracking-[0.04em] md:mt-0"
                set:html={card.description}
              />
              <Image
                src={featureImageList[i]}
                alt={card.alt}
                class="mt-26 aspect-334/195 w-full md:aspect-330/193 md:w-330"
              />
            </FadeIn>
          </div>
        ))
      }
    </div>
  </div>
</GridBox>
