---
import { Image } from "astro:assets";

import FadeIn from "../ui/common/FadeIn.astro";
import GridBox from "../ui/common/GridBox.astro";
import SectionLabel from "../ui/section/SectionLabel.astro";

import imgGallery1 from "@/assets/img-gallery-01.jpg";
import imgGallery2 from "@/assets/img-gallery-02.jpg";
import imgGallery3 from "@/assets/img-gallery-03.jpg";
import imgGallery4 from "@/assets/img-gallery-04.jpg";
import imgGallery5 from "@/assets/img-gallery-05.jpg";
---

<GridBox class="bg-black text-white" id="gallery">
  <div
    class="col-span-full pt-36 md:grid md:grid-cols-subgrid md:pt-100 md:pb-0"
  >
    <SectionLabel
      class="md:col-span-2 md:col-start-1 md:row-start-1"
      label="(GALLERY)"
    />
    <FadeIn class="mt-32 md:col-span-4 md:col-start-1 md:row-start-2 md:mt-80">
      <Image src={imgGallery1} alt="Cozy Minimalist Interior" />
    </FadeIn>
    <FadeIn class="mt-20 md:col-span-6 md:col-start-6 md:row-start-3 md:mt-140">
      <Image src={imgGallery2} alt="Modern Living Room Scene" />
    </FadeIn>
    <FadeIn class="mt-20 md:col-span-5 md:col-start-2 md:row-start-4 md:mt-140">
      <Image src={imgGallery3} alt="Wooden Rattan Dressers" />
    </FadeIn>
    <FadeIn class="mt-20 md:col-span-6 md:col-start-6 md:row-start-5 md:mt-140">
      <Image src={imgGallery4} alt="Rustic Serenity Wooden Chair" />
    </FadeIn>
    <FadeIn
      class="mt-20 overflow-hidden object-cover pb-54 md:col-span-full md:row-start-6 md:-mx-30 md:mt-140 md:aspect-1440/1203 md:pb-0"
    >
      <Image
        class="h-[110%] w-full"
        src={imgGallery5}
        alt="Scandinavian Living Room"
        data-gallery-parallax
      />
    </FadeIn>
  </div>
</GridBox>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document
      .querySelectorAll<HTMLElement>("[data-gallery-parallax]")
      .forEach((target) => {
        gsap.to(target, {
          yPercent: 10,
          ease: "none",
          scrollTrigger: {
            trigger: target,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
          },
        });
      });
  }
</script>
