---
import kvImageSp from "@/assets/img-kv-sp.jpg";
import kvImage from "@/assets/img-kv.jpg";
import GridBox from "@/components/ui/common/GridBox.astro";
import KvResponsiveImage from "@/components/ui/kv/KvResponsiveImage.astro";
---

<GridBox>
  <div
    class="relative col-span-4 col-start-1 -mx-20 h-svh md:col-span-12 md:col-start-1 md:-mx-30"
  >
    <KvResponsiveImage desktopSrc={kvImage} mobileSrc={kvImageSp} alt="" />
    <div class="absolute bottom-140 left-20 md:bottom-70 md:left-30">
      <h1 class="text-64/[1.2] font-bold tracking-[0.02em] text-white">
        あなたとともに、<br />
        変化する家具
      </h1>
      <p class="text-14/normal mt-21 font-medium text-white md:mt-29">
        木の香り、手のぬくもり、時間が育てる風合い<br />
        ここにしかない家具を、あなたの暮らしへ。
      </p>
    </div>
    <div
      class="absolute bottom-41 left-20 flex items-center justify-start gap-x-8 md:right-34 md:bottom-70 md:left-auto"
    >
      <div
        class="flex aspect-square h-auto w-20 items-center justify-center overflow-hidden rounded-full bg-white"
      >
        <span class="scroll-dot aspect-square h-auto w-4 rounded-full bg-black"
        ></span>
      </div>
      <span class="font-en text-[1.6rem] font-bold text-white">ScrollDown</span>
    </div>
  </div>
</GridBox>

<style>
  @keyframes scroll-dot {
    0% {
      transform: translateY(-300%);
    }
    100% {
      transform: translateY(300%);
    }
  }

  .scroll-dot {
    animation: scroll-dot 1.2s ease-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-dot {
      animation: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const target = document.querySelector<HTMLElement>("[data-kv-parallax]");
    const trigger = target?.closest("section") ?? target;
    if (target && trigger) {
      gsap.to(target, {
        yPercent: -10,
        ease: "none",
        scrollTrigger: {
          trigger,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
      });
    }
  }
</script>
